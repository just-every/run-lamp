{
  "schema": 1,
  "title": "Set up Lamp",
  "groups": [
    {
      "id": "page",
      "label": "Your status page"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "hosting-settings",
      "label": "Online page settings",
      "help": "For Online hosting, use Edit to complete these fields before Start. Local trials do not use them."
    },
    {
      "id": "mail",
      "label": "Online mail settings",
      "help": "For Online hosting, configure a mail provider before Start. Run Edit Run supplies managed mail settings; ordinary providers use your verified sender and provider key. Local sign-in is one click and requires no mail."
    },
    {
      "id": "sms",
      "label": "Optional SMS settings",
      "help": "Connect your registered Twilio sender to enable SMS subscriptions; local trials need no SMS account."
    }
  ],
  "fields": [
    {
      "name": "LAMP_PAGE_NAME",
      "label": "Status page name",
      "kind": "text",
      "required": true,
      "group": "page",
      "help": "Enter 1–120 characters."
    },
    {
      "name": "LAMP_PAGE_TAGLINE",
      "label": "Page description",
      "kind": "text",
      "required": true,
      "group": "page",
      "help": "Enter 1–280 characters."
    },
    {
      "name": "LAMP_PAGE_TIMEZONE",
      "label": "Page timezone",
      "kind": "timezone",
      "required": true,
      "group": "page",
      "default": "UTC"
    },
    {
      "name": "SETUP_OPERATOR_EMAIL",
      "label": "Your operator email",
      "kind": "email",
      "required": true,
      "group": "owner"
    },
    {
      "name": "OWNER_DISPLAY_NAME",
      "label": "Your name",
      "kind": "text",
      "required": true,
      "group": "owner",
      "help": "Enter 1–120 characters."
    },
    {
      "name": "LAMP_HOSTING",
      "label": "Online hosting mode",
      "kind": "select",
      "required": false,
      "default": "custom-domain",
      "group": "hosting-settings",
      "options": [
        {
          "value": "custom-domain",
          "label": "Cloudflare custom domains"
        },
        {
          "value": "workers-dev",
          "label": "Cloudflare workers.dev"
        }
      ]
    },
    {
      "name": "LAMP_PAGE_HOST",
      "label": "Public status page hostname",
      "kind": "text",
      "required": false,
      "group": "hosting-settings",
      "help": "Online only. Enter a hostname distinct from the operator address in Hosting & connections; both custom-domain zones must be active in your Cloudflare account."
    },
    {
      "name": "LAMP_ACCENT_COLOR",
      "label": "Page accent colour",
      "kind": "colour",
      "required": false,
      "default": "#163c60",
      "group": "hosting-settings"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Online mail provider",
      "kind": "select",
      "required": true,
      "default": "sendgrid",
      "group": "mail",
      "options": [
        {
          "value": "rer",
          "label": "Run Edit Run"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "resend",
          "label": "Resend"
        }
      ]
    },
    {
      "name": "MAIL_FROM",
      "label": "Managed sender address",
      "kind": "email",
      "required": false,
      "group": "mail",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": false,
      "group": "mail",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Managed mail API key",
      "kind": "secret",
      "required": false,
      "group": "mail",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        }
      ],
      "input": "entered",
      "ownerVisible": true
    },
    {
      "name": "MAIL_FROM_ADDRESS",
      "label": "Verified sender address",
      "kind": "email",
      "required": false,
      "group": "mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          }
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          }
        }
      ]
    },
    {
      "name": "MAIL_DKIM_SELECTOR",
      "label": "Sender DKIM selector",
      "kind": "text",
      "required": false,
      "group": "mail",
      "help": "Online only. The sender domain must already publish SPF, DKIM and DMARC.",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          }
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          }
        }
      ]
    },
    {
      "name": "MAIL_PROVIDER_API_KEY",
      "label": "Online mail provider API key",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "group": "mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "help": "Online only. Enter the direct provider key for this sender. It remains private and is sent only through the native deployment command."
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "help": "Online only. Enter the direct provider key for this sender. It remains private and is sent only through the native deployment command."
        }
      ],
      "when": {
        "field": "MAIL_FROM_ADDRESS",
        "nonEmpty": true
      },
      "help": "Online only. Enter the private key for your selected mail provider and verified sender."
    },
    {
      "name": "SETUP_TOKEN",
      "label": "SETUP_TOKEN",
      "kind": "secret",
      "input": "managed",
      "required": true,
      "ownerVisible": false,
      "generate": "hex"
    },
    {
      "name": "SUBSCRIBER_TOKEN_SECRET",
      "label": "SUBSCRIBER_TOKEN_SECRET",
      "kind": "secret",
      "input": "managed",
      "required": true,
      "ownerVisible": false,
      "generate": "hex"
    },
    {
      "name": "WEBHOOK_SIGNING_SECRET",
      "label": "WEBHOOK_SIGNING_SECRET",
      "kind": "secret",
      "input": "managed",
      "required": true,
      "ownerVisible": false,
      "generate": "hex"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "input": "managed",
      "required": true,
      "ownerVisible": false,
      "generate": "hex"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to use email links."
    },
    {
      "name": "AI_PROVIDER_API_KEY",
      "label": "AI provider API key",
      "help": "Optional private key for the AI provider configured in Hosting & connections.",
      "kind": "secret",
      "input": "managed",
      "required": false,
      "ownerVisible": false
    },
    {
      "name": "RER_MAIL_RELAY_SECRET",
      "label": "Managed mail relay secret",
      "help": "Optional private signing secret supplied for the Run Edit Run mail relay.",
      "kind": "secret",
      "input": "managed",
      "required": false,
      "ownerVisible": false
    },
    {
      "name": "AUTH_PROVIDERS",
      "label": "Sign-in provider configuration",
      "help": "Optional private provider configuration for operator single sign-on.",
      "kind": "secret",
      "input": "managed",
      "required": false,
      "ownerVisible": false
    },
    {
      "name": "OIDC_TRANSACTION_SECRET",
      "label": "Sign-in transaction secret",
      "help": "Optional private secret protecting single sign-on transactions when an identity provider is connected.",
      "kind": "secret",
      "input": "managed",
      "required": false,
      "ownerVisible": false
    },
    {
      "name": "TWILIO_ACCOUNT_SID",
      "label": "Twilio account ID",
      "kind": "text",
      "required": false,
      "group": "sms",
      "help": "Account identifier for your registered Twilio sender."
    },
    {
      "name": "TWILIO_AUTH_TOKEN",
      "label": "Twilio authentication token",
      "kind": "secret",
      "required": false,
      "group": "sms",
      "help": "Authenticates outbound SMS and verifies signed replies and delivery callbacks.",
      "input": "entered",
      "ownerVisible": true
    },
    {
      "name": "TWILIO_FROM_NUMBER",
      "label": "Twilio sending number",
      "kind": "text",
      "required": false,
      "group": "sms",
      "help": "Registered E.164 sending number, used without a Messaging Service."
    },
    {
      "name": "TWILIO_MESSAGING_SERVICE",
      "label": "Twilio Messaging Service",
      "kind": "text",
      "required": false,
      "group": "sms",
      "help": "Optional Messaging Service identifier used instead of the sending number."
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "lamp-native-owner"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
