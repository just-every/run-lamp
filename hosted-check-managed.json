{
  "$comment": "rer verify serves the production build with stand-ins for private inputs. Managed mail uses the declared relay bindings; native direct providers retain their ordinary input names. The DB d1 entry is the database rer deploy --rotate-secret INSTALLATION_KEY reseals: lamp-<environment>-db, as Lamp's setup records it.",
  "project": "just-every/lamp",
  "vars": {
    "LAMP_APP_HOST": "rer-hosted-check.invalid",
    "LAMP_PAGE_HOST": "status.rer-hosted-check.invalid",
    "SETUP_OPERATOR_EMAIL": "owner@rer-hosted-check.invalid",
    "MAIL_PROVIDER": "rer",
    "LAMP_RESOURCE_PREFIX": ""
  },
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "secrets": [
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "INSTALLATION_KEY",
      "environment": "INSTALLATION_KEY"
    },
    {
      "binding": "INSTALLATION_KEY_PREVIOUS",
      "environment": "INSTALLATION_KEY_PREVIOUS",
      "optional": true
    },
    {
      "binding": "SUBSCRIBER_TOKEN_SECRET",
      "environment": "SUBSCRIBER_TOKEN_SECRET"
    },
    {
      "binding": "WEBHOOK_SIGNING_SECRET",
      "environment": "WEBHOOK_SIGNING_SECRET"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "optional": true
    },
    {
      "binding": "LAMP_RESOURCE_PREFIX",
      "environment": "LAMP_RESOURCE_PREFIX",
      "optional": true
    }
  ],
  "publicSettings": [
    "LAMP_PAGE_WORKER",
    "MAIL_PROVIDER",
    "MAIL_RECIPIENTS",
    "MAIL_FROM",
    "MAIL_RELAY_URL",
    "LAMP_RESOURCE_PREFIX",
    "LAMP_APP_HOST",
    "LAMP_PAGE_HOST"
  ]
}
