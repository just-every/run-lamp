          "ends_at": "strftime('%Y-%m-%dT%H:%M:%fZ', (:now + 90000000) / 1000.0, 'unixepoch')",
          "created_by_operator_id": "(SELECT id FROM operators WHERE email = :owner_email)"
        }
      }
