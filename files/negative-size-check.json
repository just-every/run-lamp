          "tagline": "'Synthetic verification only'",
          "accent_color": "'#2563eb'",
          "timezone": "'UTC'",
          "hostname": "'synthetic-lamp-1.example.test'",
          "created_at": "strftime('%Y-%m-%dT%H:%M:%fZ', :now / 1000.0, 'unixepoch')",
          "updated_at": "strftime('%Y-%m-%dT%H:%M:%fZ', :now / 1000.0, 'unixepoch')"
        }
      },
      {
        "table": "components",
        "rows": 644,
        "values": {
          "id": "printf('1%025d', n)",
          "created_at": "strftime('%Y-%m-%dT%H:%M:%fZ', (:now - 3888000000 + n * 1000) / 1000.0, 'unixepoch')",
          "updated_at": "strftime('%Y-%m-%dT%H:%M:%fZ', (:now - 3888000000 + n * 1000) / 1000.0, 'unixepoch')",
          "name": "printf('synthetic-lamp-%d', n)",
          "description": "'Synthetic monitored service'",
          "display_order": "n"
