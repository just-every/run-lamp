{
  "name": "lamp",
  "version": "1.11.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "description": "A status page and incident communication desk for one business.",
  "scripts": {
    "migrate:local": "node scripts/migrate-local.mjs",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "release:candidate": "node scripts/create-release-candidate.mjs",
    "lamp-site:intro": "node scripts/lamp-site/intro.mjs",
    "lamp-site:mark": "node scripts/lamp-site/mark.mjs",
    "authoring": "node scripts/edition-authoring/cli.mjs",
    "operations": "node scripts/operations.mjs",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "source:release": "node scripts/edition-authoring/cli.mjs release",
    "verify:visual": "node scripts/verify-visual-edit.mjs",
    "source:copies": "node scripts/edition-authoring/cli.mjs verify-base --offline",
    "signin-link": "node scripts/signin-link.mjs",
    "setup": "rer setup",
    "dev": "rer dev",
    "preview": "rer preview",
    "build": "rer build",
    "verify": "rer verify",
    "verify:release": "node tests/release/verify.mjs",
    "reset": "rer reset",
    "deploy": "rer deploy",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "dev:app": "node scripts/dev.mjs",
    "build:app": "node scripts/build.mjs",
    "verify:app": "node scripts/verification/run.mjs",
    "setup:cloudflare": "node scripts/setup.mjs",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "export:cloudflare": "node scripts/export.mjs",
    "import:cloudflare": "node scripts/import.mjs",
    "verify:visual:source": "node --experimental-strip-types scripts/verify-visual-edit.mjs --source-only",
    "verify:plan": "node scripts/verification/check-plan.mjs",
    "sorry:capture": "node --experimental-strip-types scripts/sorry-capture.mjs",
    "sorry:receipt": "node --experimental-strip-types scripts/sorry-receipt.mjs",
    "test:ownership": "node --test --test-concurrency=1 tests/e2e/auth-adoption-journey.test.mjs tests/auth-adoption/dependencies.test.mjs tests/auth-adoption/sign-in-providers.test.mjs tests/auth-adoption/upgrade.test.mjs",
    "test:demo": "node --test --test-concurrency=1 tests/demo/journey.test.mjs",
    "test:portability": "node --test --test-concurrency=1 tests/auth-adoption/portability.test.mjs tests/e2e/page-data.test.mjs tests/e2e/prior-backup.test.mjs",
    "test:imports": "node --test --test-concurrency=1 tests/e2e/statuspage-import.test.mjs tests/e2e/cutover-browser.test.mjs tests/e2e/sorry-import.test.mjs",
    "test:composer": "node --test --test-concurrency=1 tests/e2e/publishing-browser.test.mjs tests/e2e/maintenance-timezone.test.mjs tests/e2e/unsaved-work-browser.test.mjs",
    "test:delivery": "node --test --test-concurrency=1 tests/e2e/delivery-contract.test.mjs",
    "test:publishing": "node --test --test-concurrency=1 tests/e2e/publishing-contract.test.mjs tests/e2e/incident-brief.test.mjs tests/e2e/update-reminders.test.mjs",
    "test:public": "node --test --test-concurrency=1 tests/e2e/public-contract.test.mjs tests/e2e/snapshot-retained.test.mjs",
    "test:runtime": "node --test --test-concurrency=1 tests/e2e/start-runtime.test.mjs tests/e2e/independent-release.test.mjs",
    "test:site": "node --test --test-concurrency=1 tests/lamp-site/browser.test.mjs tests/e2e/website-onboarding.test.mjs",
    "test": "node scripts/verification/run.mjs",
    "test:baseline": "node scripts/baseline/run.mjs",
    "test:owner-claim": "node --test --test-concurrency=1 tests/demo/owner-claim.test.mjs",
    "test:channels": "node --test --test-concurrency=1 tests/e2e/channels-and-presets.test.mjs",
    "test:mail": "node --test --test-concurrency=1 tests/e2e/rer-mail.test.mjs",
    "build:site": "rer build --site",
    "test:owner-backup": "node --test --test-concurrency=1 tests/e2e/export-import.test.mjs",
    "check:contract-docs": "node src/base/contract-docs.mjs check"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "3.2.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.76",
    "@tailwindcss/vite": "^4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "22.19.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "ical.js": "2.2.1",
    "marked": "18.0.14",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-lamp.git"
  },
  "engines": {
    "node": "22.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "miniflare@5.20260907.0-alpha>sharp": "0.35.5",
      "miniflare@5.20260907.0-alpha>undici": "7.29.1",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
