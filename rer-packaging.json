{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/lamp",
    "name": "Lamp",
    "sourceRepository": "https://github.com/just-every/run-lamp",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "lamp-worker-artifact.json"
    },
    "operations": {
      "setup": "bash scripts/independent-build-setup.sh",
      "build": "pnpm run build",
      "verify": "pnpm run validate:release && pnpm run check -- --profile first-party && pnpm run source:check && pnpm run source:copies",
      "artifact": "node scripts/build-delivery-artifact.mjs",
      "recovery": "Follow OPERATIONS.md: pause writes and scheduled work, retain exact source and private secrets, export D1 and R2, restore into fresh empty resources, re-export and compare bytes, then verify native sessions and publication before routing traffic. SnapshotCache is derived from retained R2 generation; existing migration names and bytes must remain unchanged."
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "lamp-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "providerEffects": [
        "outbound-mail",
        "ai",
        "outbound-webhooks"
      ],
      "surfaces": {
        "app": {
          "path": "/signin",
          "hostnameVariable": "LAMP_APP_HOST",
          "signIn": {
            "path": "/signin",
            "loginHint": true,
            "ownerSignIn": "/auth/owner-signin"
          }
        },
        "page": {
          "path": "/",
          "hostnameVariable": "LAMP_PAGE_HOST",
          "readiness": [
            {
              "path": "/",
              "statuses": [
                200
              ],
              "pendingSetupStatuses": [
                503
              ]
            }
          ]
        }
      },
      "initialSetup": {
        "path": "/setup/status",
        "pendingStatus": 409,
        "completeStatus": 200
      },
      "publicVariableNames": [
        "LAMP_PAGE_HOST",
        "LAMP_APP_HOST",
        "MAIL_FROM_ADDRESS",
        "MAIL_PROVIDER",
        "SENDGRID_WEBHOOK_PUBLIC_KEY",
        "AI_PROVIDER_URL",
        "AI_PROVIDER_MODEL",
        "RER_MANAGEMENT_ORIGIN",
        "RER_INSTALLATION_ID",
        "RER_MAIL_RELAY_URL",
        "RER_RELEASE_DIGEST",
        "AUTH_ORIGIN",
        "SETUP_OPERATOR_EMAIL",
        "IDENTITY_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_DKIM_SELECTOR",
        "MAIL_SECONDARY_PROVIDER",
        "MAILGUN_REGION",
        "SES_REGION",
        "SES_CONFIGURATION_SET",
        "SES_EVENT_TOPIC_ARN"
      ],
      "secretNames": [
        "SETUP_TOKEN",
        "SESSION_SECRET",
        "SUBSCRIBER_TOKEN_SECRET",
        "WEBHOOK_SIGNING_SECRET",
        "INSTALLATION_KEY"
      ],
      "optionalSecretNames": [
        "RESEND_WEBHOOK_SECRET",
        "AI_PROVIDER_API_KEY",
        "RER_MAIL_RELAY_SECRET",
        "AUTH_PROVIDERS",
        "OIDC_TRANSACTION_SECRET",
        "MAIL_API_KEY",
        "MAIL_PROVIDER_API_KEY",
        "SLACK_SIGNING_SECRET",
        "SLACK_CLIENT_ID",
        "SLACK_CLIENT_SECRET",
        "MAIL_SECONDARY_API_KEY",
        "MAILGUN_WEBHOOK_SIGNING_KEY",
        "POSTMARK_WEBHOOK_SECRET",
        "POSTMARK_ACCOUNT_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_FROM_NUMBER",
        "TWILIO_MESSAGING_SERVICE",
        "INSTALLATION_KEY_PREVIOUS"
      ],
      "migrationPrefix": "core-",
      "recovery": "Retain source and database backup before migration. Preserve applied migration history. Restore into fresh installation resources and verify owner workflows before switching traffic.",
      "extraMigrationDirectories": [
        {
          "binding": "DB",
          "path": "migrations/ext",
          "prefix": "ext-",
          "optional": true
        }
      ],
      "mail": {
        "providers": [
          "rer"
        ]
      }
    },
    "mainModule": "rer-entry.js",
    "additionalModules": [
      {
        "name": "rer-entry.js",
        "type": "esm",
        "path": "scripts/delivery/rer-entry.template.mjs"
      }
    ]
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/lamp"
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
