{
  "schema": 1,
  "about": "Synthetic Lamp translation of the published ChargeDesk count geometry, not a claim about a Lamp customer: 644 knowledge documents map to fixed monitored components and 644 alert_sources (monitor definitions); 9,000 recent chats map to 90/9,000 resolved incidents, each with three updates (270/27,000) and one component attachment; 161,893 conversations map to 1,619/161,893 accumulated component history transitions; 162,000 contacts map to 1,620/162,000 subscription records, only 1,000 active at either size (the rest deactivated), within Lamp's 25,000 active/pending cap. One future maintenance window exercises the scheduler's idle work. All contents synthetic. These are explicit domain analogies, not measured Lamp cardinalities; HH tables and source-block fanouts are not Lamp schema. Window/growth budgets retain the published 3.9M/10%+200 working line; per-flow ceilings fixed before measurement, no growth exemption.",
  "database": "DB",
  "budget": {
    "windowRows": 3900000,
    "growthPercent": 10,
    "growthRows": 200,
    "timeoutSeconds": 600
  },
  "personas": {
    "owner": {
      "kind": "owner"
    },
    "reader": {
      "kind": "anonymous"
    }
  },
  "shape": {
    "tables": [
      {
        "table": "page_settings",
        "rows": 1,
