{
  "name": "lamp",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "description": "A status page and incident communication desk for one business.",
  "scripts": {
    "migrate:local": "node scripts/migrate-local.mjs",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 tests/release-history.test.mjs",
    "test:api": "node --test --test-concurrency=1 tests/e2e/app-api.test.mjs",
    "test:delivery": "node --test --test-concurrency=1 tests/e2e/subscriber-erasure.test.mjs && node --test --test-concurrency=1 tests/e2e/sendgrid-provider.test.mjs && node --test --test-concurrency=1 tests/e2e/delivery-contract.test.mjs && node --test --test-concurrency=1 tests/e2e/dispatch-persistence.test.mjs && node --test --test-concurrency=1 tests/e2e/dispatch-token-batch.test.mjs && node --test --test-concurrency=1 tests/e2e/rer-mail.test.mjs",
    "test:publishing": "node --test --test-concurrency=1 tests/e2e/publishing-contract.test.mjs",
    "test:public": "node --test --test-concurrency=1 tests/e2e/snapshot-retained.test.mjs && node --test --test-concurrency=1 tests/e2e/queue-outage.test.mjs && node --test --test-concurrency=1 tests/e2e/public-contract.test.mjs",
    "test:accessibility": "node --test --test-concurrency=1 tests/e2e/accessibility.test.mjs",
    "test:baseline": "node scripts/baseline/run.mjs",
    "test:extensions": "node --test --test-concurrency=1 tests/e2e/extensions-contract.test.mjs",
    "test:export-import": "node --test --test-concurrency=1 tests/e2e/export-import.test.mjs",
    "test:deployment-artifact": "node --test --test-concurrency=1 tests/delivery-deployment-spec.test.mjs tests/delivery-migration-order.mjs tests/delivery-artifact-producer.test.mjs tests/delivery-wrapper.test.mjs && node --test --test-concurrency=1 tests/e2e/deployment-secrets.test.mjs && node --test --test-concurrency=1 tests/e2e/deployment-artifact.test.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "release:candidate": "node scripts/create-release-candidate.mjs",
    "lamp-site:intro": "node scripts/lamp-site/intro.mjs",
    "lamp-site:mark": "node scripts/lamp-site/mark.mjs",
    "test:docs": "node --test --test-concurrency=1 tests/docs/docs-site.test.mjs",
    "test:lamp-site": "node --test --test-concurrency=1 tests/lamp-site/browser.test.mjs",
    "test:publishing-browser": "node --test --test-concurrency=1 tests/e2e/publishing-browser.test.mjs",
    "test:ui-interactions": "node --test --test-concurrency=1 tests/e2e/ui-interactions.test.mjs",
    "test:start-runtime": "pnpm run build:app && pnpm run test:start-runtime:built",
    "authoring": "node scripts/edition-authoring/cli.mjs",
    "operations": "node scripts/operations.mjs",
    "test:operations": "node --test --test-concurrency=1 tests/operations-description.test.mjs",
    "source:check": "node scripts/edition-authoring/cli.mjs check",
    "test:owner-migrations": "node scripts/test-owner-migrations.mjs",
    "source:release": "node scripts/edition-authoring/cli.mjs release",
    "verify:visual": "node scripts/verify-visual-edit.mjs",
    "test:independent-release": "pnpm run test:independent-packaging && pnpm run test:independent-runtime",
    "test:installer": "node --test --test-concurrency=1 tests/installer.test.mjs tests/installer-receipt.test.mjs",
    "test:autosave-integrity": "node --test --test-concurrency=1 tests/e2e/autosave-integrity.test.mjs",
    "test:maintenance-timezone": "node --test --test-concurrency=1 tests/e2e/maintenance-timezone.test.mjs",
    "test:reference-storage": "node --test --test-concurrency=1 tests/reference-storage/*.test.mjs",
    "test:workflow-render": "node --test --test-concurrency=1 tests/render/*.test.mjs",
    "test:public-snapshots": "node --test --test-concurrency=1 tests/public-snapshots/*.test.mjs",
    "test:intake-references": "node --test --test-concurrency=1 tests/e2e/intake-references.test.mjs",
    "test:resolve-composer": "node --test --test-concurrency=1 tests/resolve-composer/*.test.mjs",
    "test:dev-ingress": "node --test --test-concurrency=1 tests/dev-ingress/*.test.mjs",
    "source:copies": "node scripts/edition-authoring/cli.mjs verify-base --offline",
    "signin-link": "node scripts/signin-link.mjs",
    "test:operator-readiness": "node --test --test-concurrency=1 tests/operator-readiness/checklist.test.mjs tests/auth-adoption/upgrade.test.mjs tests/auth-adoption/dependencies.test.mjs tests/auth-adoption/portability.test.mjs tests/auth-adoption/operator-erasure.test.mjs tests/auth-adoption/import-authority.test.mjs tests/e2e/signin-link.test.mjs tests/e2e/setup-readiness.test.mjs",
    "setup": "rer setup",
    "dev": "rer dev",
    "preview": "rer preview",
    "build": "rer build",
    "verify": "rer verify",
    "verify:release": "node tests/release/verify.mjs",
    "reset": "rer reset",
    "deploy": "rer deploy",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "dev:app": "node scripts/dev.mjs",
    "build:app": "node scripts/build.mjs",
    "verify:app": "node scripts/verification/run.mjs",
    "setup:cloudflare": "node scripts/setup.mjs",
    "deploy:cloudflare": "node scripts/deploy.mjs",
    "export:cloudflare": "node scripts/export.mjs",
    "import:cloudflare": "node scripts/import.mjs",
    "test:rer-journey": "node --test --test-concurrency=1 tests/e2e/auth-adoption-journey.test.mjs",
    "test:move-in": "pnpm run test:move-in:cutover && pnpm run test:move-in:statuspage && pnpm run test:move-in:betterstack && pnpm run test:move-in:instatus && pnpm run test:move-in:sorry",
    "test:channels-and-presets": "node --test --test-concurrency=1 tests/e2e/channels-and-presets.test.mjs",
    "test:incident-brief": "node --test --test-concurrency=1 tests/e2e/incident-brief.test.mjs",
    "test:update-reminders": "node --test --test-concurrency=1 tests/e2e/update-reminders.test.mjs",
    "test:external-heartbeat": "node --test --test-concurrency=1 tests/external-heartbeat.test.mjs",
    "test:demo": "node --test --test-concurrency=1 tests/demo/*.test.mjs",
    "test:start-runtime:built": "node --test --test-concurrency=1 tests/e2e/start-runtime.test.mjs",
    "test:independent-packaging": "node --test --test-concurrency=1 tests/delivery-credential-files.test.mjs",
    "test:independent-runtime": "node --test --test-concurrency=1 tests/e2e/independent-release.test.mjs",
    "verify:visual:source": "node --experimental-strip-types scripts/verify-visual-edit.mjs --source-only",
    "verify:visual:heading": "node scripts/verification/visual-heading.mjs",
    "verify:plan": "node scripts/verification/check-plan.mjs",
    "test:move-in:cutover": "node --test --test-concurrency=1 tests/auth-adoption/cutover.test.mjs tests/e2e/cutover-browser.test.mjs",
    "test:move-in:statuspage": "node --test --test-concurrency=1 tests/e2e/statuspage-import.test.mjs",
    "test:move-in:betterstack": "node --test --test-concurrency=1 tests/betterstack/reader.test.mjs tests/betterstack/flow.test.mjs tests/e2e/betterstack-browser.test.mjs",
    "test:move-in:instatus": "node --test --test-concurrency=1 tests/instatus/reader.test.mjs tests/e2e/instatus-import.test.mjs tests/e2e/instatus-browser.test.mjs",
    "test:move-in:sorry": "node --test --test-concurrency=1 tests/e2e/sorry-import.test.mjs",
    "sorry:capture": "node --experimental-strip-types scripts/sorry-capture.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.55.1",
    "@runeditrun/rer": "0.2.29",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "playwright": "1.55.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-lamp.git"
  },
  "engines": {
    "node": "22.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "miniflare@5.20260907.0-alpha>sharp": "0.35.5",
      "miniflare@5.20260907.0-alpha>undici": "7.29.1",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
