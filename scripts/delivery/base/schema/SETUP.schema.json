{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rer:setup:1",
  "title": "Setup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "groups",
    "fields",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "minItems": 1
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "business": {
      "$ref": "#/$defs/business"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "uniqueItems": true
    },
    "dependencyGraph": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "values"],
      "properties": {
        "settings": {
          "const": 1
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["display_name", "owner_name", "brand_color", "logo", "timezone"]
          },
          "description": "Business values rendered at runtime by this seed. Must include display_name. Logo is delivered only through the signed settings document."
        },
        "team": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles"],
          "properties": {
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["admin", "member"],
              "properties": {
                "admin": {"$ref": "#/$defs/businessTeamRole"},
                "member": {"$ref": "#/$defs/businessTeamRole"}
              }
            }
          }
        }
      }
    },
    "businessTeamRole": {
      "type": "string",
      "pattern": "^(?![Oo][Ww][Nn][Ee][Rr]$)(?!\\s)(?![\\s\\S]*\\s$)[^\\x00-\\x1f\\x7f-\\x9f]{1,64}$",
      "description": "Seed-owned role name for Business teammates. Must never grant ownership; the seed adapter also enforces its native ownership rules."
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string"
        },
        "audience": {
          "enum": ["owner", "developer"],
          "description": "Audience inherited by this group's public fields: owner when absent, or developer. An explicit owner field inside a developer group is invalid. This metadata does not change local installer or rer setup visibility."
        },
        "presentations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/groupPresentation"
          },
          "minItems": 1
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "text",
            "email",
            "url",
            "select",
            "colour",
            "timezone",
            "secret"
          ]
        },
        "audience": {
          "enum": ["owner", "developer"],
          "description": "Public fields only: owner or developer. When absent, inherit the group's audience, or owner without a group audience. An explicit owner value inside a developer group is invalid. This metadata does not change local installer or rer setup visibility; secret visibility uses ownerVisible and input."
        },
        "businessField": {
          "enum": [
            "owner_email",
            "legal_name",
            "timezone",
            "currency",
            "jurisdiction",
            "mail_sender",
            "display_name",
            "owner_name",
            "brand_color",
            "entity_type",
            "state_of_organization",
            "fiscal_year_start",
            "books_start_date",
            "tax_method",
            "country",
            "state"
          ],
          "description": "Optional public-field hint identifying the business profile value represented by this input. Secrets cannot declare this hint. It does not supply an answer or change validation."
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "runtimeEditable": {
          "type": "boolean"
        },
        "prefill": {
          "const": "account-email"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "presentations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldPresentation"
          },
          "minItems": 1
        },
        "generate": {
          "enum": [
            "hex",
            "base64"
          ]
        },
        "ownerVisible": {
          "type": "boolean"
        },
        "input": {
          "enum": [
            "entered",
            "managed"
          ]
        },
        "localDefault": {
          "type": [
            "string",
            "object"
          ],
          "additionalProperties": false,
          "properties": {
            "generate": {
              "enum": [
                "hex",
                "base64"
              ]
            },
            "from": {
              "const": "origin"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "secret"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "required",
              "ownerVisible"
            ],
            "not": {
              "required": ["businessField"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "select"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fieldPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "order": {
          "type": "integer"
        }
      }
    },
    "groupPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "equals": {
          "type": "string"
        },
        "nonEmpty": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additionalFields"
      ],
      "properties": {
        "additionalFields": {
          "type": "boolean"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          },
          "uniqueItems": true
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "owner-claim",
            "extension"
          ]
        },
        "mode": {
          "enum": [
            "signed",
            "setup-token",
            "idp"
          ]
        },
        "emailField": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "tokenField": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~/-]*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "dependency": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "owner-claim"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "mode",
              "emailField"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "extension"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "signed"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "tokenField",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "idp"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "dependency",
              "path"
            ]
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "optional",
        "cardinality",
        "address",
        "paths"
      ],
      "properties": {
        "interface": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
        },
        "optional": {
          "type": "boolean"
        },
        "cardinality": {
          "const": 1
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~/-]+$"
          }
        }
      }
    }
  }
}
